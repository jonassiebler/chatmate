version: "2"

run:
  timeout: 5m
  go: "1.25"
  disable-default-linters: true

linters:
  disable-all: true

linters-settings:
  gofmt:
    simplify: true
  goimports:
    local-prefixes: github.com/jonassiebler/chatmate
  goconst:
    min-len: 2
    min-occurrences: 3
  misspell:
    locale: US

issues:
  exclude-rules:
    - path: _test\.go
      linters:
        - goconst
        - errcheck
        - staticcheck
    - path: cmd/
      linters:
        - goconst
    - path: test/
      linters:
        - errcheck
        - staticcheck
    - path: internal/testing/
      linters:
        - errcheck
        - staticcheck
  max-issues-per-linter: 50
  max-same-issues: 10
